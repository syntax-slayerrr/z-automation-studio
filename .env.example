# ============================================================================
# Z-AUTOMATION STUDIO — KONFIGURASI API KEY (.env.example)
# ============================================================================
# Cara pakai untuk pemula:
#   1. Duplikat / salin file ini dan beri nama: .env
#   2. Isi ELEVENLABS_API_KEY di bawah ini dengan API Key dari https://elevenlabs.io
#   3. Simpan file .env, lalu ketik prompt video yang kamu inginkan ke AI Agent!
# ============================================================================

# Wajib untuk Voice-Over Bahasa Indonesia (eleven_v4) & Efek Suara (eleven_text_to_sound_v3)
ELEVENLABS_API_KEY=isi_api_key_elevenlabs_kamu_di_sini

# Opsional: Hanya diperlukan jika ingin memakai narator Cartesia (sonic-3) di ipm-chronicles
CARTESIA_API_KEY=

# Opsional: Hanya diperlukan jika ingin mengambil SFX tambahan dari Freesound API
FREESOUND_API_KEY=
