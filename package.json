{
  "name": "z-automation-studio",
  "version": "1.0.0",
  "description": "Motion graphics, promotional reels, and video automation studio for Z-Automation",
  "private": true,
  "scripts": {
    "dev": "remotion studio remotion/index.ts",
    "studio": "remotion studio remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "render:sawah": "powershell -NoProfile -ExecutionPolicy Bypass -File sawah-terasering/scripts/render_sawah_chunks.ps1",
    "still:sawah": "remotion still remotion/entry-sawah.ts SawahTeraseringShort sawah-terasering/out/cover.png --frame=755 --gl=angle",
    "render:tiang": "powershell -NoProfile -ExecutionPolicy Bypass -File tiang-listrik/scripts/render_tiang_chunks.ps1",
    "still:tiang": "remotion still remotion/entry-tiang.ts TiangListrikShort tiang-listrik/out/cover.png --frame=540 --gl=angle",
    "render:rel": "powershell -NoProfile -ExecutionPolicy Bypass -File rel-kereta/scripts/render_rel_chunks.ps1",
    "still:rel": "remotion still remotion/index.ts RelKeretaShort rel-kereta/out/cover.png --frame=420 --gl=angle",
    "render:earth24h": "remotion render remotion/index.ts Earth24HoursShort earth-24h/out/remotion_earth24h.mp4",
    "still:earth24h": "remotion still remotion/index.ts Earth24HoursShort earth-24h/out/remotion_stills/cover.png --frame=60",
    "render:blackhole": "remotion render remotion/index.ts BlackHoleShort black-hole/out/black_hole_short.mp4 --concurrency=1 --gl=angle",
    "still:blackhole": "remotion still remotion/index.ts BlackHoleShort black-hole/out/cover.png --frame=0 --gl=angle",
    "render:humanfire": "powershell -NoProfile -ExecutionPolicy Bypass -File human-fire/scripts/render_humanfire_chunks.ps1",
    "still:humanfire": "remotion still remotion/index.ts HumanFireShort human-fire/out/cover.png --frame=45",
    "render:gmni": "powershell -NoProfile -ExecutionPolicy Bypass -File gmni-history/scripts/render_gmni_chunks.ps1",
    "still:gmni": "remotion still remotion/index.ts GmniHistoryShort gmni-history/out/cover.png --frame=3830",
    "render:guntur": "powershell -NoProfile -ExecutionPolicy Bypass -File gunung-guntur/scripts/render_guntur_chunks.ps1",
    "still:guntur": "remotion still remotion/index.ts GunungGunturShort gunung-guntur/out/cover.png --frame=2520",
    "render:gambut": "powershell -NoProfile -ExecutionPolicy Bypass -File gambut-history/scripts/render_gambut_chunks.ps1",
    "still:gambut": "remotion still remotion/index.ts GambutHistoryShort gambut-history/out/cover.png --frame=2710",
    "render:reel": "remotion render remotion/index.ts ZAutomationLaunch out/reels/z-automation-launch.mp4",
    "render:diorama": "remotion render remotion/index.ts HistoricalDioramaReel out/reels/historical-diorama.mp4",
    "still:diorama": "remotion still remotion/index.ts HistoricalDioramaReel out/thumbnails/diorama-cover.png --frame=60",
    "render:kakarut": "remotion render remotion/index.ts KakarutShort out/reels/asal-usul-garut-kakarut.mp4",
    "still:kakarut": "remotion still remotion/index.ts KakarutShort out/thumbnails/kakarut-cover.png --frame=60",
    "render:5s": "remotion render remotion/index.ts CinematicHistory5s out/reels/cinematic-5s.mp4",
    "still:5s": "remotion still remotion/index.ts CinematicHistory5s out/thumbnails/cinematic-5s.png --frame=60",
    "render:shotcraft": "remotion render remotion/index.ts ShotcraftGarutMaster out/reels/shotcraft-garut-master.mp4 --concurrency=1 --gl=angle",
    "still:shotcraft": "remotion still remotion/index.ts ShotcraftGarutMaster out/thumbnails/shotcraft-garut-cover.png --frame=60",
    "render:kurzgesagt": "remotion render remotion/index.ts KurzgesagtBlackHole out/reels/kurzgesagt-black-hole.mp4",
    "render:square": "remotion render remotion/index.ts ZAutomationSquarePromo out/feed/z-automation-promo.mp4",
    "render:all": "npm run render:reel && npm run render:square",
    "produce:reel": "powershell -ExecutionPolicy Bypass -File scripts/produce.ps1 -Format reel",
    "produce:feed": "powershell -ExecutionPolicy Bypass -File scripts/produce.ps1 -Format feed",
    "still:thumbnail": "remotion still remotion/index.ts ZAutomationLaunch out/thumbnails/reel-cover.png --frame=60",
    "still:square": "remotion still remotion/index.ts ZAutomationSquarePromo out/thumbnails/feed-cover.png --frame=45",
    "ipm:studio": "npm --prefix ipm-chronicles run studio",
    "ipm:tsc": "tsc --noEmit -p ipm-chronicles/tsconfig.json",
    "ipm:still:ep01": "npm --prefix ipm-chronicles run still:ep01",
    "ipm:render:ep01": "npm --prefix ipm-chronicles run render:ep01",
    "elevenlabs:vo": "node --env-file=.env ipm-chronicles/pipeline/elevenlabs_client.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "^4.0.541",
    "@remotion/player": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "lucide-react": "^1.16.0",
    "postprocessing": "^6.39.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.541",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3"
  }
}
