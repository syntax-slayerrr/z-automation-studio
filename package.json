    "still:kakarut": "remotion still remotion/index.ts KakarutShort out/thumbnails/kakarut-cover.png --frame=60",
    "render:5s": "remotion render remotion/index.ts CinematicHistory5s videos/cinematic-5s.mp4",
    "still:5s": "remotion still remotion/index.ts CinematicHistory5s out/thumbnails/cinematic-5s.png --frame=60",
    "render:shotcraft": "remotion render remotion/index.ts ShotcraftGarutMaster videos/shotcraft-garut-master.mp4 --concurrency=1 --gl=angle",
    "still:shotcraft": "remotion still remotion/index.ts ShotcraftGarutMaster out/thumbnails/shotcraft-garut-cover.png --frame=60",
    "render:kurzgesagt": "remotion render remotion/index.ts KurzgesagtBlackHole videos/kurzgesagt-black-hole.mp4",
    "render:square": "remotion render remotion/index.ts ZAutomationSquarePromo videos/z-automation-promo.mp4",
    "render:all": "npm run render:reel && npm run render:square",
    "produce:reel": "powershell -ExecutionPolicy Bypass -File scripts/produce.ps1 -Format reel",
    "produce:feed": "powershell -ExecutionPolicy Bypass -File scripts/produce.ps1 -Format feed",
    "still:thumbnail": "remotion still remotion/index.ts ZAutomationLaunch out/thumbnails/reel-cover.png --frame=60",
    "still:square": "remotion still remotion/index.ts ZAutomationSquarePromo out/thumbnails/feed-cover.png --frame=45",
    "ipm:studio": "npm --prefix ipm-chronicles run studio",
    "ipm:tsc": "tsc --noEmit -p ipm-chronicles/tsconfig.json",
    "ipm:still:ep01": "npm --prefix ipm-chronicles run still:ep01",
    "ipm:render:ep01": "npm --prefix ipm-chronicles run render:ep01",
    "elevenlabs:vo": "node --env-file=.env ipm-chronicles/pipeline/elevenlabs_client.mjs"
